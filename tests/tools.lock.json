    "br_search_case_stj": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Search STJ (Superior Tribunal de Justica) acordaos - real ruling text.\n\nUnlike `br_search_processos` (DataJud, metadata only), this returns the\nactual `ementa` (headnote) and `decisao` (ruling body prose) from the\nSTJ Open Data Portal. Scans the most recent monthly bulk files for one\norgao julgador (chamber/section) - a miss means \"not in the scanned\nwindow\", not \"does not exist\". Coverage starts May 2022.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "default": 20,
              "description": "max results (default 20).",
              "type": "integer"
            },
            "orgao": {
              "description": "deciding chamber/section, one of the keys in the supported\nlist, e.g. ``\"CORTE ESPECIAL\"``, ``\"TERCEIRA TURMA\"``.",
              "type": "string"
            },
            "query": {
              "description": "free text - a process/registration number (6+ digits) matches\nexactly; anything else matches `ministroRelator` or `ementa`\n(case-insensitive substring).",
              "type": "string"
            }
          },
          "required": [
            "orgao",
            "query"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_search_case_stj",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "1f2bb7b39e207ab78c2ce64a2d90baf01a21a2eb472e3a9f14be6172f6ee3f10"
    },
    "br_search_case_tcu": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Search TCU (Federal Court of Accounts) acordaos - public-procurement\nand public-spending jurisprudence.\n\nReturns summaries (`sumario`) plus the index's own total. Use\n`br_get_case_tcu` for the full ruling text of one acordao. The query\nsupports the portal's own field-scoped syntax in addition to plain\nwords, e.g. ``NUMACORDAO:1771 ANOACORDAO:2026``.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "default": 20,
              "description": "max results (default 20).",
              "type": "integer"
            },
            "query": {
              "description": "free text or field-scoped query.",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_search_case_tcu",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "05a040b2c960ad0f723c52e73bb0d25385824bb471e18f650d0465586b3bf678"
    },
    "br_search_case_tst": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Search TST (labor supreme court) rulings by free text - real ruling text.\n\nThe query goes into the TST frontend's own \"contendo as palavras\" (AND)\nfield - quote an expression for an exact-phrase match, e.g.\n``\"adicional de insalubridade\"``. Returns the index's own total plus a\npage of records carrying the real `ementa` and `inteiro_teor` prose.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "default": 20,
              "description": "max results per page (default 20).",
              "type": "integer"
            },
            "query": {
              "description": "free text (AND semantics; quotes for exact phrase).",
              "type": "string"
            },
            "tipo": {
              "default": "ACORDAO",
              "description": "document type - ``\"ACORDAO\"`` (default), ``\"DESPACHO\"``,\n``\"SUM\"`` (sumulas), ``\"OJ\"`` (orientacoes jurisprudenciais),\n``\"PN\"``, ``\"DESPGP\"``, ``\"DESPGVP\"``, ``\"DESPGCG\"``.",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_search_case_tst",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "58b0996c4db7fcea60740d514e7ad915eefd7d305ce776a46f50461a03c1bd95"
    },
    "br_search_processos": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Search court dockets (procedural metadata, NOT ruling text) in one\ntribunal's DataJud CNJ index.\n\nDataJud carries classe/assuntos/orgaoJulgador and the full procedural\ntimeline (`movimentos`) for each docket - it does not carry the prose\ntext of a ruling/acordao/ementa. STF is not covered (see server docstring).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "default": 20,
              "description": "max results (default 20).",
              "type": "integer"
            },
            "query": {
              "description": "free text - a CNJ process number (15+ digits) matches\n`numeroProcesso` exactly; anything else matches `classe.nome`.",
              "type": "string"
            },
            "tribunal": {
              "description": "one of the supported tribunal codes, e.g. ``\"STJ\"``,\n``\"TST\"``, ``\"TRF1\"``, ``\"TJSP\"``, ``\"TRT2\"``, ``\"TRE-SP\"``.",
              "type": "string"
            }
          },
          "required": [
            "tribunal",
            "query"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_search_processos",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "3692502cc1ad5d4d0753711a1fe708dee8bdc00dbe45ffa17cdc0820a20e3702"
    },
