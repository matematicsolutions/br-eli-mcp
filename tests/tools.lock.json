{
  "package_version": "0.8.3",
  "tools": {
    "br_coverage": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Declare what this connector covers, how it is sourced, and what it does NOT cover.\n\nCall this before telling a user that the law \"does not contain\" something, and whenever\na search comes back empty: the absence may be a gap in this connector rather than in the\nlaw. Every gap carries a fallback saying where to look instead.\n\nReturns:\n    ``Coverage`` with families, an as-of note, and a non-empty list of known gaps.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {},
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_coverage",
        "outputSchema": {
          "additionalProperties": true,
          "description": "What this connector covers, how it is sourced, and what it does not cover.",
          "properties": {
            "as_of_note": {
              "description": "States what the dates mean, and what they do not promise.",
              "type": "string"
            },
            "families": {
              "items": {
                "additionalProperties": true,
                "description": "One data family this connector exposes.",
                "properties": {
                  "captured_at": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Date this family was last captured (ISO). None when queried live."
                  },
                  "live": {
                    "default": true,
                    "description": "True when queried live instead of from a snapshot.",
                    "type": "boolean"
                  },
                  "name": {
                    "description": "Data family, e.g. 'Federal legislation'.",
                    "type": "string"
                  },
                  "source": {
                    "description": "Official source the data comes from.",
                    "type": "string"
                  },
                  "tool": {
                    "description": "Tool or tools that reach this family.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "tool",
                  "source"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "known_gaps": {
              "description": "Never empty. An empty list would mean 'not checked', not 'no gaps'.",
              "items": {
                "additionalProperties": true,
                "description": "A known, named hole in this connector's coverage - plus the way around it.",
                "properties": {
                  "fallback": {
                    "description": "Where to go instead.",
                    "type": "string"
                  },
                  "family": {
                    "description": "Which family the gap belongs to.",
                    "type": "string"
                  },
                  "id": {
                    "description": "Stable gap identifier.",
                    "type": "string"
                  },
                  "missing": {
                    "description": "What is NOT available through this connector.",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "family",
                  "missing",
                  "fallback"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "status": {
              "default": "ok",
              "enum": [
                "ok",
                "degraded",
                "failed"
              ],
              "type": "string"
            }
          },
          "required": [
            "as_of_note"
          ],
          "type": "object"
        }
      },
      "sha256": "cb80a68d5e9175bcc5017ad4d97e7a98412b9567a28eb31cdde7fdbaae0100f5"
    },
    "br_get_case_carf": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Fetch one CARF (tax appeals) acordao by exact docket or decision number.\n\nExactly one of `numero_processo` / `numero_decisao` must be given - this\nis an exact lookup, not a search. There is no free-text search tool for\nCARF because its full-text index is not reliably populated upstream\n(confirmed empty on live probing for common Portuguese terms).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "numero_decisao": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "CARF decision number, e.g. ``\"9101-002.402\"``."
            },
            "numero_processo": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "CARF docket number, e.g. ``\"16095.000602/2007-70\"``."
            }
          },
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_get_case_carf",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "7c5e9bac78fde55eee0fb2171e2aecbf262d2ad57d43173447bc4b43d8d38a42"
    },
    "br_get_case_stj": {
