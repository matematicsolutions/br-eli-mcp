          "properties": {
            "numero_processo": {
              "description": "the STJ process or registration number (digits;\npunctuation ignored).",
              "type": "string"
            },
            "orgao": {
              "description": "deciding chamber/section, e.g. ``\"CORTE ESPECIAL\"``.",
              "type": "string"
            }
          },
          "required": [
            "orgao",
            "numero_processo"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_get_case_stj",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "d2c8a515f639994f5761b4cf7aa002c30f7f9e00c9190d9e3ba4211b19862412"
    },
    "br_get_case_tcu": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Fetch one TCU acordao with the real ruling text: `acordao_texto`\n(deliberation), `relatorio` (rapporteur's report) and `voto` (vote).\n\nA TCU acordao is uniquely identified by (numero, ano, colegiado) - the\nsame numero/ano recurs across the Plenario and the two Camaras. When\n`colegiado` is omitted and more than one acordao matches, this errors\nand lists the matching bodies instead of guessing.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "ano": {
              "description": "four-digit year, e.g. ``\"2026\"``.",
              "type": "string"
            },
            "colegiado": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "deciding body - ``\"Plenário\"``, ``\"Primeira Câmara\"`` or\n``\"Segunda Câmara\"`` (accent-sensitive, as spelled in the index)."
            },
            "numero": {
              "description": "acordao number, e.g. ``\"1771\"``.",
              "type": "string"
            }
          },
          "required": [
            "numero",
            "ano"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_get_case_tcu",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "14ae882bd8c82a6d80222a71520d6525da6053d23a9a1b30d88a6f5ca8b0496c"
    },
    "br_get_case_tst": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Fetch one TST ruling by its exact CNJ unified process number - real\nruling text (`ementa` + `inteiro_teor`).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "numero_processo": {
              "description": "CNJ unified process number, formatted\n(``\"21036-38.2019.5.04.0021\"``) or as the raw 20 digits. The\nfifth segment is 5 (Justica do Trabalho) for every TST case.",
              "type": "string"
            },
            "tipo": {
              "default": "ACORDAO",
              "description": "document type (default ``\"ACORDAO\"``).",
              "type": "string"
            }
          },
          "required": [
            "numero_processo"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_get_case_tst",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "c396625d34e4b04b15084ecee7db48054ad2d692b02ae8219b77ac55f0ec2da9"
    },
    "br_get_norma": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Resolve a Brazilian Norma Juridica (enacted law/decree/amendment) by its URN Lex.\n\nIdentification + Diario Oficial da Uniao publication provenance + amendment\nhistory + any STF unconstitutionality notes - NOT the full compiled article\ntext (no confirmed URL rule to Planalto; see DISCOVERY.md).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "urn": {
              "description": "a URN Lex, e.g. ``\"urn:lex:br:federal:lei:2002-01-10;10406\"``\n(Codigo Civil). Must start with ``\"urn:lex:br:\"`` - never invent one,\ntake it from the user or from another tool's output.",
              "type": "string"
            }
          },
          "required": [
            "urn"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_get_norma",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "647d092e88f15dc743742c7d2b45dfef54fb0fcab3bb71c5da754ee2dde20fc2"
    },
    "br_get_norma_index": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "List the addressable structure of a Norma Juridica: parts, books, titles,\nchapters, sections, and articles, in document order.\n\nUse this to find the `dispositivo` suffix for the article you need (e.g.\n`\"art5\"`), then pass it to `br_get_norma_texto` - do not guess a suffix.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "urn": {
              "description": "a URN Lex, e.g. ``\"urn:lex:br:federal:lei:2002-01-10;10406\"``\n(Codigo Civil). Must start with ``\"urn:lex:br:\"``.",
              "type": "string"
            }
          },
          "required": [
            "urn"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_get_norma_index",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "4e89846b661543d3dec1c63a2f2fc5545c45d148dee45a9a4b339f62c9a1cfed"
    },
    "br_get_norma_texto": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Fetch the real text of one dispositivo (article, or a titulo/capitulo\nheader) of a Norma Juridica.\n\nAn article's text includes its caput and every paragraph/inciso/alinea\nbeneath it, concatenated in document order - not a summary.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "dispositivo": {
              "description": "a suffix from `br_get_norma_index`, e.g. ``\"art5\"``.\nNever guess one - a wrong suffix returns `not_found`, it does not\nsilently fall back to a different article.",
              "type": "string"
            },
            "urn": {
              "description": "a URN Lex, e.g. ``\"urn:lex:br:federal:lei:2002-01-10;10406\"``.",
              "type": "string"
            }
          },
          "required": [
            "urn",
            "dispositivo"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "br_get_norma_texto",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "dcf4c52923e22e1cb238855790ef0bfae5587a7ec659facf7d87a85a69d8a1a0"
    },
